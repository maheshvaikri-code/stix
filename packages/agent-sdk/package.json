{
  "name": "@stix/agent-sdk",
  "version": "0.1.9",
  "description": "STIX Agent SDK - Enterprise policy enforcement for AI agents",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/integrations/openai.d.ts",
      "import": "./dist/integrations/openai.mjs",
      "require": "./dist/integrations/openai.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.mjs",
      "require": "./dist/integrations/langchain.js"
    },
    "./anthropic": {
      "types": "./dist/integrations/anthropic.d.ts",
      "import": "./dist/integrations/anthropic.mjs",
      "require": "./dist/integrations/anthropic.js"
    },
    "./gitlab": {
      "types": "./dist/integrations/gitlab.d.ts",
      "import": "./dist/integrations/gitlab.mjs",
      "require": "./dist/integrations/gitlab.js"
    },
    "./fabric": {
      "types": "./dist/fabric.d.ts",
      "import": "./dist/fabric.mjs",
      "require": "./dist/fabric.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/fabric.ts src/integrations/anthropic.ts src/integrations/gitlab.ts src/integrations/langchain.ts src/integrations/openai.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/fabric.ts src/integrations/anthropic.ts src/integrations/gitlab.ts src/integrations/langchain.ts src/integrations/openai.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stix/fabric-types": "workspace:*",
    "@stix/shared": "workspace:*",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "@langchain/core": ">=0.1.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "stix",
    "policy",
    "enforcement",
    "ai",
    "agent",
    "security",
    "compliance",
    "authorization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stix-ai/stix.git",
    "directory": "packages/agent-sdk"
  }
}
