{
  "name": "@stix/target-email",
  "version": "0.1.6",
  "description": "STIX Target Email - Protected email sending service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stix-target-email": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
