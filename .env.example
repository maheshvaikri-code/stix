# =============================================================================
# STIX Platform Environment Configuration
# Copy this file to .env and customize for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Common Settings
# -----------------------------------------------------------------------------
NODE_ENV=dev                    # dev | test | stage | prod
LOG_LEVEL=debug                 # error | warn | info | http | debug | trace
LOG_PRETTY=true                 # Pretty print logs (development)

# -----------------------------------------------------------------------------
# Enforcer Service
# -----------------------------------------------------------------------------
ENFORCER_PORT=3001
ENFORCER_HOST=0.0.0.0

# Policy evaluation service URL
POLICY_SERVICE_URL=http://localhost:3002

# Evidence recording service URL
EVIDENCE_SERVICE_URL=http://localhost:3003

# Approvals service URL
APPROVALS_SERVICE_URL=http://localhost:3004

# Fail mode when STIX is unavailable
# CLOSED = deny all (safest)
# OPEN_LOW_RISK_ONLY = allow low-risk only
# OPEN = allow all (not recommended for prod)
DEFAULT_FAIL_MODE=CLOSED

# Token settings
TOKEN_EXPIRY_SECONDS=300
CACHE_DECISIONS=true
CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Policy Service
# -----------------------------------------------------------------------------
POLICY_PORT=3002
POLICY_HOST=0.0.0.0

# Storage type: memory | sqlite | postgres
STORAGE_TYPE=memory
SQLITE_PATH=./data/policies.db
POSTGRES_URL=postgresql://user:pass@localhost:5432/stix

# Policies path for file-based loading
POLICIES_PATH=./policies/examples

# Policy configuration
POLICY_DEFAULT_PRIORITY=100
POLICY_CACHE_TTL=60
POLICY_MAX_PER_TENANT=1000

# -----------------------------------------------------------------------------
# Evidence Service
# -----------------------------------------------------------------------------
EVIDENCE_PORT=3003
EVIDENCE_HOST=0.0.0.0

# Storage type: memory | sqlite | postgres | s3
EVIDENCE_STORAGE_TYPE=memory
EVIDENCE_SQLITE_PATH=./data/evidence.db
EVIDENCE_POSTGRES_URL=postgresql://user:pass@localhost:5432/stix

# S3 settings (if using S3 storage)
S3_BUCKET=stix-evidence
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Evidence settings
EVIDENCE_RETENTION_DAYS=2555
EVIDENCE_ARCHIVE_DAYS=365
EVIDENCE_MAX_BATCH=100

# Signing settings
SIGNING_ENABLED=true
SIGNING_KEY_PATH=./keys/stix-signing.pem
SIGNING_KEY_ID=stix-key-1

# -----------------------------------------------------------------------------
# Approvals Service
# -----------------------------------------------------------------------------
APPROVALS_PORT=3004
APPROVALS_HOST=0.0.0.0

# Approval settings
APPROVAL_TIMEOUT_HOURS=24
APPROVAL_MAX_TIMEOUT_HOURS=168
APPROVAL_REQUIRED_COUNT=1

# Notification webhook (optional)
APPROVAL_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Redis (Caching)
# -----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=stix:
REDIS_TLS=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# mTLS settings
MTLS_ENABLED=false
MTLS_CA_PATH=./certs/ca.pem
MTLS_CERT_PATH=./certs/server.pem
MTLS_KEY_PATH=./certs/server-key.pem

# API key for service-to-service communication
API_KEY=

# CORS settings
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# OpenTelemetry
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=stix

# Health check
HEALTH_CHECK_INTERVAL=30000

# -----------------------------------------------------------------------------
# Database (PostgreSQL - Production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://stix:stix@localhost:5432/stix
DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT=10000
DATABASE_CONNECTION_TIMEOUT=5000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_ASYNC_EVIDENCE=true
FEATURE_POLICY_CACHE=true
FEATURE_HASH_CHAIN_VERIFICATION=true
