{
  "name": "@stix/monorepo",
  "version": "0.1.6",
  "private": true,
  "description": "STIX Core and STIX Fabric - trusted execution and policy fabric for AI agents",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "tools/*",
    "cli",
    "dashboard",
    "targets/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @stix/shared build",
    "build:fabric-types": "pnpm --filter @stix/fabric-types build",
    "build:services": "pnpm --filter './services/*' build",
    "build:sdk": "pnpm --filter @stix/agent-sdk build && pnpm --filter @stix/target-verifier build",
    "dev": "pnpm -r --parallel dev",
    "dev:enforcer": "pnpm --filter @stix/enforcer dev",
    "dev:policy": "pnpm --filter @stix/policy dev",
    "dev:evidence": "pnpm --filter @stix/evidence dev",
    "dev:approvals": "pnpm --filter @stix/approvals dev",
    "dev:fabric": "pnpm --filter @stix/fabric dev",
    "start": "pnpm -r start",
    "test": "pnpm -r test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "npx tsx tests/run-integration.ts",
    "test:integration:watch": "npx tsx tests/run-integration.ts --watch",
    "test:smoke": "pnpm --filter @stix/cli exec node dist/index.js test smoke --api-url http://localhost:3001",
    "test:load": "pnpm --filter @stix/cli exec node dist/index.js test load --api-url http://localhost:3001",
    "dr:backup": "powershell -ExecutionPolicy Bypass -File scripts/dr/backup-postgres.ps1",
    "dr:restore": "powershell -ExecutionPolicy Bypass -File scripts/dr/restore-postgres.ps1",
    "dr:verify": "powershell -ExecutionPolicy Bypass -File scripts/dr/verify-dr.ps1",
    "perf:load": "node scripts/perf/stix-load.mjs",
    "perf:suite": "node scripts/perf/run-profile-suite.mjs",
    "perf:report": "node scripts/perf/generate-capacity-report.mjs",
    "integration:combined-adapter": "node scripts/integrations/combined-architecture-adapter.mjs",
    "ops:slo-signoff": "node scripts/ops/generate-slo-signoff.mjs",
    "ops:attestation-packet": "node scripts/ops/generate-attestation-packet.mjs",
    "ops:resilience-drill": "node scripts/ops/run-resilience-drill.mjs",
    "ops:replay-smoke": "node -e \"const fs=require('fs'); fs.rmSync('packages/shared/dist',{recursive:true,force:true}); fs.rmSync('packages/shared/tsconfig.tsbuildinfo',{force:true}); fs.mkdirSync('artifacts/ops',{recursive:true});\" && pnpm --filter @stix/shared build && pnpm --filter @stix/verify build && pnpm --filter @stix/replay build && pnpm --filter @stix/verify exec node dist/cli.js chain ../../tests/fixtures/ops/replay-events.json && pnpm --filter @stix/replay exec node dist/cli.js run --bundles ../../tests/fixtures/ops/replay-bundle.json --policies ../../tests/fixtures/ops/replay-policy.yaml --strict --strict-obligations --format markdown --output ../../artifacts/ops/replay-report.md",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec -- rm -rf dist node_modules",
    "clean:dist": "pnpm -r exec -- rm -rf dist",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "docker:build": "docker compose -f deploy/docker/docker-compose.yaml build",
    "docker:up": "docker compose -f deploy/docker/docker-compose.yaml up -d",
    "docker:down": "docker compose -f deploy/docker/docker-compose.yaml down",
    "docker:logs": "docker compose -f deploy/docker/docker-compose.yaml logs -f",
    "k8s:apply": "kubectl apply -f deploy/k8s/",
    "k8s:delete": "kubectl delete -f deploy/k8s/",
    "demo:fabric:seed": "node scripts/demo/seed-fabric-demo.mjs",
    "prepare": "pnpm build:shared && pnpm build:fabric-types"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "prettier": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.12.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stix-platform/stix.git"
  },
  "keywords": [
    "stix",
    "compliance",
    "authorization",
    "ai-governance",
    "guardrails",
    "policy",
    "audit",
    "enterprise"
  ],
  "author": "STIX Platform Team",
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.14.4",
      "@protobufjs/utf8": "^1.1.2",
      "brace-expansion": "^5.0.8",
      "fast-uri": "^4.1.1",
      "lodash": "^4.18.1",
      "minimatch": "^10.2.5",
      "picomatch": "^4.0.5",
      "postcss": "^8.5.10",
      "protobufjs": "^8.7.1",
      "sharp": "^0.35.3",
      "ajv@^8.0.0": "^8.20.0"
    }
  }
}
