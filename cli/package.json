{
  "name": "@stix/cli",
  "version": "0.1.7",
  "description": "STIX CLI - Command line tools for STIX management",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stix": "./dist/index.js",
    "stix-cli": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@stix/shared": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "yaml": "^2.9.0",
    "glob": "^13.0.6",
    "undici": "^6.27.0",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
